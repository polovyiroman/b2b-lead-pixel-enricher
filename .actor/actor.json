{
    "actorSpecification": 1,
    "name": "b2b-lead-tech-pixel-enricher",
    "title": "B2B Lead, Email, Socials & Ad Pixel Enricher",
    "description": "Evidence-based B2B lead enricher: extracts verified emails, B2B phones, source URLs, ad pixel evidence (GTM & HTML), and actionable sales opportunities.",
    "version": "2.0",
    "meta": {
        "templateId": "python-start"
    },
    "input": "./input_schema.json",
    "dockerfile": "../Dockerfile",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "fields": {},
            "views": {
                "overview": {
                    "title": "CRM-Ready B2B Leads & Evidence",
                    "transformation": {
                        "fields": [
                            "input_domain",
                            "status",
                            "page_title",
                            "best_email",
                            "best_email_type",
                            "email_source_url",
                            "primary_phone",
                            "phone_source_url",
                            "detected_signals",
                            "sales_opportunity",
                            "signal_confidence",
                            "technology_evidence",
                            "linkedin_url",
                            "instagram_url",
                            "facebook_url",
                            "telegram_url",
                            "tiktok_url",
                            "youtube_url",
                            "social_source_url",
                            "has_meta_pixel",
                            "has_tiktok_pixel",
                            "has_google_ads",
                            "has_ga4",
                            "has_gtm",
                            "detected_technologies",
                            "all_emails",
                            "all_phones",
                            "meta_description",
                            "website_url",
                            "last_checked_at"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "input_domain": { "label": "Domain", "format": "text" },
                            "status": { "label": "Status", "format": "text" },
                            "page_title": { "label": "Company / Page Title", "format": "text" },
                            "best_email": { "label": "Best Email", "format": "text" },
                            "best_email_type": { "label": "Email Category", "format": "text" },
                            "email_source_url": { "label": "Email Source URL", "format": "link" },
                            "primary_phone": { "label": "Primary Phone (B2B)", "format": "text" },
                            "phone_source_url": { "label": "Phone Source URL", "format": "link" },
                            "detected_signals": { "label": "Detected Signals", "format": "text" },
                            "sales_opportunity": { "label": "Sales Opportunity", "format": "text" },
                            "signal_confidence": { "label": "Confidence", "format": "text" },
                            "technology_evidence": { "label": "Tech Evidence", "format": "text" },
                            "linkedin_url": { "label": "LinkedIn", "format": "link" },
                            "instagram_url": { "label": "Instagram", "format": "link" },
                            "facebook_url": { "label": "Facebook", "format": "link" },
                            "telegram_url": { "label": "Telegram", "format": "link" },
                            "tiktok_url": { "label": "TikTok", "format": "link" },
                            "youtube_url": { "label": "YouTube", "format": "link" },
                            "social_source_url": { "label": "Social Source URL", "format": "link" },
                            "has_meta_pixel": { "label": "Meta Pixel", "format": "boolean" },
                            "has_tiktok_pixel": { "label": "TikTok Pixel", "format": "boolean" },
                            "has_google_ads": { "label": "Google Ads", "format": "boolean" },
                            "has_ga4": { "label": "GA4", "format": "boolean" },
                            "has_gtm": { "label": "GTM", "format": "boolean" },
                            "detected_technologies": { "label": "All Tech (Semicolon List)", "format": "text" },
                            "all_emails": { "label": "All Emails", "format": "text" },
                            "all_phones": { "label": "All Phones", "format": "text" },
                            "meta_description": { "label": "Meta Description", "format": "text" },
                            "website_url": { "label": "Final URL", "format": "link" },
                            "last_checked_at": { "label": "Checked At (UTC)", "format": "text" }
                        }
                    }
                }
            }
        }
    }
}
